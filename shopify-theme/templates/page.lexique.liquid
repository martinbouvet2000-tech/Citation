{% comment %}
  Page Lexique LED & skincare — AURÉLIA
  Handle Shopify attendu : lexique
  Template autonome. CSS scopé par préfixe .lexique-*.
  Glossaire éditorial de 30+ termes, ordonné alphabétiquement, index ancre.
{% endcomment %}

<style>
  /* ─── Hero ─── */
  .lexique-hero {
    padding: 6rem 2rem 4rem;
    background:
      radial-gradient(ellipse at 20% 30%, var(--rose-pale) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 70%, var(--gold-pale) 0%, transparent 55%),
      var(--ivory);
    text-align: center;
    border-bottom: 1px solid var(--line);
  }
  .lexique-hero-inner { max-width: 760px; margin: 0 auto; }
  .lexique-hero .eyebrow { display: inline-block; margin-bottom: 1.2rem; color: var(--bordeaux); }
  .lexique-hero h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 4.8vw, 3.8rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 1.4rem;
    color: var(--ink);
  }
  .lexique-hero h1 em { font-style: italic; color: var(--bordeaux); font-weight: 300; }
  .lexique-hero .lead {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    color: var(--ink-2);
    line-height: 1.6;
    max-width: 620px;
    margin: 0 auto;
  }

  /* ─── Index alphabétique sticky ─── */
  .lexique-index {
    background: var(--cream);
    border-bottom: 1px solid var(--line);
    padding: 1.1rem 2rem;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .lexique-index-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem 0.7rem;
  }
  .lexique-index a {
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
    padding: 0.35rem 0.55rem;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }
  .lexique-index a:hover {
    color: var(--bordeaux);
    border-color: var(--gold);
    background: var(--pearl);
  }
  .lexique-index a.is-empty {
    color: var(--ink-faded);
    pointer-events: none;
    opacity: 0.4;
  }

  /* ─── Layout principal ─── */
  .lexique-main {
    padding: 4rem 2rem 6rem;
    background: var(--ivory);
  }
  .lexique-main-inner {
    max-width: 980px;
    margin: 0 auto;
  }

  .lexique-letter-block {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 2rem;
    padding-bottom: 3rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--line);
  }
  .lexique-letter-block:last-child { border-bottom: none; }

  .lexique-letter {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(4rem, 7vw, 6rem);
    font-style: italic;
    font-weight: 400;
    color: var(--gold);
    line-height: 1;
    position: sticky;
    top: 90px;
    align-self: flex-start;
  }

  .lexique-entries {
    display: flex;
    flex-direction: column;
  }

  .lexique-entry {
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  .lexique-entry:last-child { border-bottom: none; }
  .lexique-entry:first-child { padding-top: 0; }

  .lexique-entry h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.55rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.6rem;
    line-height: 1.2;
  }
  .lexique-entry h3 em { font-style: italic; color: var(--bordeaux); }
  .lexique-entry p {
    color: var(--ink-2);
    font-size: 0.96rem;
    line-height: 1.75;
    margin-bottom: 0.7rem;
  }
  .lexique-entry p:last-child { margin-bottom: 0; }
  .lexique-entry a {
    color: var(--bordeaux);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--gold);
  }
  .lexique-entry a:hover {
    text-decoration-color: var(--bordeaux);
  }
  .lexique-source {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.82rem;
    color: var(--ink-3);
    font-style: italic;
  }

  /* ─── CTA bas de page ─── */
  .lexique-cta {
    padding: 5rem 2rem;
    background: var(--ink);
    color: var(--cream);
    text-align: center;
  }
  .lexique-cta-inner { max-width: 640px; margin: 0 auto; }
  .lexique-cta h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 400;
    color: var(--cream);
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .lexique-cta h2 em { font-style: italic; color: var(--gold-light); }
  .lexique-cta p {
    color: var(--ink-faded);
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .lexique-cta a.cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2rem;
    background: var(--gold);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .lexique-cta a.cta-link:hover {
    background: var(--gold-light);
    transform: translateY(-1px);
  }

  /* ─── Responsive ─── */
  @media (max-width: 760px) {
    .lexique-hero { padding: 4.5rem 1.4rem 3.5rem; }
    .lexique-main { padding: 3rem 1.4rem 5rem; }
    .lexique-letter-block {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding-bottom: 2.4rem;
      margin-bottom: 2.4rem;
    }
    .lexique-letter {
      position: static;
      font-size: 3.2rem;
      margin-bottom: 0.4rem;
    }
    .lexique-index { padding: 0.8rem 1rem; }
    .lexique-index a { font-size: 0.72rem; padding: 0.3rem 0.4rem; }
    .lexique-cta { padding: 4rem 1.4rem; }
  }

  /* ─── Smooth scroll ─── */
  html { scroll-behavior: smooth; }
</style>

