{% comment %}
  Page FAQ — AURÉLIA
  Handle Shopify attendu : faq
  Template autonome. CSS scopé par préfixe .faq-page-*.
  Réutilise les classes globales .faq-item / .faq-question / .faq-answer
  (animation et logique JS gérées par theme.css et theme.js).
{% endcomment %}

<style>
  /* ─── Hero ─── */
  .faq-page-hero {
    position: relative;
    padding: 6.5rem 2rem 4.5rem;
    background:
      radial-gradient(ellipse at 20% 30%, var(--rose-pale) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 70%, var(--gold-pale) 0%, transparent 55%),
      var(--ivory);
    text-align: center;
  }
  .faq-page-hero-inner { max-width: 780px; margin: 0 auto; }
  .faq-page-hero .eyebrow { display: inline-block; margin-bottom: 1.2rem; }
  .faq-page-hero h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 1.4rem;
    color: var(--ink);
  }
  .faq-page-hero h1 em { font-style: italic; color: var(--bordeaux); font-weight: 300; }
  .faq-page-hero .lead {
    font-size: 1.05rem;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto;
    font-weight: 300;
  }

  /* ─── Mini navigation interne ─── */
  .faq-page-nav {
    background: var(--cream);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 1.4rem 2rem;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .faq-page-nav-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2rem;
    justify-content: center;
    align-items: center;
  }
  .faq-page-nav a {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    font-weight: 500;
    transition: color 0.2s;
    text-decoration: none;
  }
  .faq-page-nav a:hover { color: var(--bordeaux); }

  /* ─── Catégories ─── */
  .faq-page-section {
    padding: 5rem 2rem;
    background: var(--ivory);
  }
  .faq-page-section:nth-of-type(even) { background: var(--cream); }
  .faq-page-section-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .faq-page-cat-head {
    text-align: center;
    margin-bottom: 3rem;
  }
  .faq-page-cat-num {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.4rem;
    color: var(--gold);
    display: block;
    margin-bottom: 0.4rem;
  }
  .faq-page-cat-head h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 400;
    color: var(--ink);
    line-height: 1.2;
  }
  .faq-page-cat-head h2 em { font-style: italic; color: var(--bordeaux); }
  .faq-page-cat-head p {
    margin-top: 0.8rem;
    color: var(--ink-3);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* ─── CTA bas de page ─── */
  .faq-page-cta {
    padding: 5rem 2rem;
    background: var(--ink);
    color: var(--cream);
    text-align: center;
  }
  .faq-page-cta-inner { max-width: 640px; margin: 0 auto; }
  .faq-page-cta h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 400;
    color: var(--cream);
    margin-bottom: 1rem;
  }
  .faq-page-cta h2 em { font-style: italic; color: var(--gold-light); }
  .faq-page-cta p {
    color: var(--ink-faded);
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .faq-page-cta .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2.2rem;
    background: var(--pearl);
    color: var(--ink);
    border: 1px solid var(--pearl);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    transition: all 0.3s ease;
    text-decoration: none;
  }
  .faq-page-cta .btn:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
    transform: translateY(-1px);
  }

  @media (max-width: 760px) {
    .faq-page-hero, .faq-page-section, .faq-page-cta { padding: 4rem 1.4rem; }
    .faq-page-nav { position: static; }
    .faq-page-nav-inner { gap: 0.6rem 1.2rem; }
  }
</style>

