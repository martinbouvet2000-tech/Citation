{% comment %}
  Page À propos — AURÉLIA
  Handle Shopify attendu : a-propos
  Ce template autonome injecte son propre HTML et CSS scopé (.about-*).
  Aucune dépendance hors des variables :root globales (--ivory, --bordeaux, --gold, etc.).
{% endcomment %}

<style>
  /* ─── Scope: page À propos ─── */
  .about-hero {
    position: relative;
    padding: 7rem 2rem 5rem;
    background:
      radial-gradient(ellipse at 15% 25%, var(--rose-pale) 0%, transparent 55%),
      radial-gradient(ellipse at 85% 75%, var(--gold-pale) 0%, transparent 55%),
      var(--ivory);
    overflow: hidden;
    text-align: center;
  }
  .about-hero-inner {
    max-width: 880px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .about-hero .eyebrow { display: inline-block; margin-bottom: 1.4rem; }
  .about-hero h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.6rem, 5.5vw, 4.4rem);
    font-weight: 400;
    line-height: 1.08;
    margin-bottom: 1.8rem;
    color: var(--ink);
  }
  .about-hero h1 em { font-style: italic; color: var(--bordeaux); font-weight: 300; }
  .about-manifesto {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    color: var(--ink-2);
    line-height: 1.65;
    max-width: 680px;
    margin: 0 auto;
  }
  .about-manifesto::before,
  .about-manifesto::after {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--gold);
    margin: 1.8rem auto;
  }

  /* ─── Histoire ─── */
  .about-story {
    padding: 7rem 2rem;
    background: var(--ivory);
  }
  .about-story-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  .about-story-visual {
    aspect-ratio: 4/5;
    border-radius: 4px;
    background: linear-gradient(135deg, var(--cream), var(--rose-pale) 55%, var(--gold-pale));
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }
  .about-story-visual::after {
    content: 'AURÉLIA · PARIS';
    position: absolute;
    bottom: 1.6rem;
    left: 1.6rem;
    font-size: 0.66rem;
    letter-spacing: 0.32em;
    color: var(--bordeaux);
    font-weight: 500;
  }
  .about-story-text h2 {
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    margin-bottom: 1.4rem;
    line-height: 1.15;
  }
  .about-story-text h2 em { font-style: italic; color: var(--bordeaux); }
  .about-story-text p {
    color: var(--ink-2);
    line-height: 1.85;
    margin-bottom: 1.2rem;
    font-size: 1.02rem;
  }
  .about-signature {
    display: block;
    margin-top: 2rem;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.4rem;
    color: var(--bordeaux);
  }
  .about-signature small {
    display: block;
    font-family: 'Inter', sans-serif;
    font-style: normal;
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 0.4rem;
    font-weight: 400;
  }

  /* ─── Engagements ─── */
  .about-values {
    padding: 7rem 2rem;
    background: linear-gradient(180deg, var(--cream) 0%, var(--ivory) 100%);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .about-values-inner { max-width: 1180px; margin: 0 auto; }
  .about-values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.4rem;
    margin-top: 3.5rem;
  }
  .about-value {
    background: var(--pearl);
    padding: 2.6rem 2rem;
    border-radius: 4px;
    border: 1px solid var(--line);
    text-align: left;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .about-value:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }
  .about-value-num {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 2.2rem;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 1rem;
    display: block;
  }
  .about-value h3 {
    font-size: 1.5rem;
    margin-bottom: 0.8rem;
    color: var(--ink);
  }
  .about-value p {
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  /* ─── Équipe ─── */
  .about-team { padding: 7rem 2rem; background: var(--ivory); }
  .about-team-inner { max-width: 1180px; margin: 0 auto; }
  .about-team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.4rem;
    margin-top: 3.5rem;
  }
  .about-portrait {
    text-align: center;
  }
  .about-portrait-img {
    aspect-ratio: 3/4;
    background: linear-gradient(160deg, var(--rose-pale), var(--cream), var(--gold-pale));
    border-radius: 4px;
    margin-bottom: 1.4rem;
    position: relative;
    overflow: hidden;
  }
  .about-portrait-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(107,35,54,0.06) 100%);
  }
  .about-portrait h3 {
    font-size: 1.35rem;
    margin-bottom: 0.3rem;
  }
  .about-portrait .role {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bordeaux);
    font-weight: 500;
    margin-bottom: 0.8rem;
    display: block;
  }
  .about-portrait .bio {
    color: var(--ink-3);
    font-size: 0.9rem;
    line-height: 1.7;
    max-width: 280px;
    margin: 0 auto;
  }

  /* ─── Citation de clôture ─── */
  .about-quote {
    padding: 7rem 2rem;
    background: var(--ink);
    color: var(--cream);
    text-align: center;
  }
  .about-quote-inner { max-width: 820px; margin: 0 auto; }
  .about-quote blockquote {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.45;
    color: var(--cream);
    font-weight: 300;
  }
  .about-quote blockquote::before {
    content: '«';
    display: block;
    font-size: 4rem;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 0.8rem;
  }
  .about-quote cite {
    display: block;
    margin-top: 2rem;
    font-style: normal;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold-light);
    font-weight: 400;
  }

  /* ─── CTA final ─── */
  .about-cta {
    padding: 6rem 2rem;
    text-align: center;
    background: var(--ivory);
  }
  .about-cta h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    margin-bottom: 1rem;
  }
  .about-cta h2 em { font-style: italic; color: var(--bordeaux); }
  .about-cta p {
    color: var(--ink-3);
    max-width: 540px;
    margin: 0 auto 2.4rem;
    line-height: 1.7;
  }
  .about-cta .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2.2rem;
    background: var(--ink);
    color: var(--pearl);
    border: 1px solid var(--ink);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    transition: all 0.3s ease;
  }
  .about-cta .btn:hover {
    background: var(--bordeaux);
    border-color: var(--bordeaux);
    transform: translateY(-1px);
    box-shadow: 0 12px 28px -10px rgba(107, 35, 54, 0.4);
  }

  /* ─── Responsive ─── */
  @media (max-width: 880px) {
    .about-story-inner,
    .about-values-grid,
    .about-team-grid {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
    .about-hero, .about-story, .about-values, .about-team, .about-quote, .about-cta {
      padding: 4.5rem 1.4rem;
    }
    .about-portrait .bio { max-width: 100%; }
  }
</style>

{%- comment -%} ─────────────────────────────  HERO ───────────────────────────── {%- endcomment -%}
<section class="about-hero">
  <div class="about-hero-inner">
    <img src="{{ 'logo-stamp.svg' | asset_url }}" alt="Aurélia Paris" style="width:120px;height:120px;margin:0 auto 2rem;display:block;opacity:0.92;">
    <span class="eyebrow">Notre maison</span>
    <h1>L'éclat, comme un <em>rituel quotidien</em>.</h1>
    <p class="about-manifesto">
      AURÉLIA est née d'une conviction simple : la lumière qui transforme la peau ne devrait pas être l'apanage des cabinets parisiens. Elle devrait vivre chez vous, sur votre coiffeuse, dans la douceur d'un soir d'hiver — sans compromis sur la rigueur clinique.
    </p>
  </div>
</section>

{%- comment -%} ────────────────────────  NOTRE HISTOIRE ──────────────────────── {%- endcomment -%}
<section class="about-story">
  <div class="about-story-inner">
    <div class="about-story-visual" aria-hidden="true"></div>
    <div class="about-story-text">
      <span class="eyebrow">Notre histoire</span>
      <h2>Du latin <em>aurum</em>, l'or.</h2>
      <p>
        Pendant huit ans, j'ai conseillé des femmes dans les boutiques d'Estée Lauder, sur les Champs-Élysées puis avenue Montaigne. J'ai vu défiler des routines somptueuses, des sérums brevetés, des promesses tenues — et d'autres, beaucoup moins. Mais une chose me frappait toujours : pour accéder à la luminothérapie LED — celle qui a réellement transformé la dermatologie esthétique — il fallait pousser la porte d'un institut et débourser 250 € la séance.
      </p>
      <p>
        En 2024, j'ai quitté la grande maison pour fonder AURÉLIA. L'idée n'était pas de copier un appareil professionnel et d'en faire un gadget. C'était de concevoir, à Paris, un objet à la hauteur du rituel : des longueurs d'onde validées par la littérature dermatologique, une intensité calibrée pour un usage quotidien, et un design dont on n'a pas honte sur l'étagère de la salle de bain.
      </p>
      <p>
        Nous travaillons avec un atelier d'optique de précision en Europe centrale, choisi pour son obsession du détail — les mêmes mains qui assemblent certaines lunettes haute couture. Chaque masque est testé, calibré, puis emballé dans nos ateliers parisiens. Rien n'est sous-traité au hasard.
      </p>
      <p>
        AURÉLIA, c'est la conviction qu'un soin véritablement efficace peut aussi être beau, lent, et silencieux. Un moment pour soi, dix minutes par jour, à la lumière dorée de la marque.
      </p>
      <span class="about-signature">
        Aurélia
        <small>Fondatrice</small>
      </span>
    </div>
  </div>
</section>

{%- comment -%} ────────────────────────  NOS ENGAGEMENTS ──────────────────────── {%- endcomment -%}
<section class="about-values">
  <div class="about-values-inner">
    <div class="section-head">
      <span class="eyebrow">Nos engagements</span>
      <h2>Trois principes, <em>non négociables</em>.</h2>
      <p>Ce qui guide chacune de nos décisions, du laboratoire à votre coiffeuse.</p>
    </div>
    <div class="about-values-grid">
      <article class="about-value">
        <span class="about-value-num">I.</span>
        <h3>Exigence clinique</h3>
        <p>
          Longueurs d'onde 630&nbsp;nm (rouge) et 830&nbsp;nm (infrarouge proche) validées par plus de 40 études dermatologiques. Densité d'irradiance mesurée, jamais survendue. Nos protocoles sont relus par un comité scientifique indépendant.
        </p>
      </article>
      <article class="about-value">
        <span class="about-value-num">II.</span>
        <h3>Sourcing européen</h3>
        <p>
          Optique de précision assemblée en Europe centrale, électronique calibrée en Allemagne, conditionnement à Paris. Une chaîne d'approvisionnement courte, traçable, et auditée chaque année par nos équipes.
        </p>
      </article>
      <article class="about-value">
        <span class="about-value-num">III.</span>
        <h3>Design intemporel</h3>
        <p>
          Pensé pour durer, pas pour étonner. Lignes épurées, matières nobles, finitions ivoire et or pâle. Un objet qui se fond dans votre quotidien — et qui sera toujours là dans dix ans.
        </p>
      </article>
    </div>
  </div>
</section>

{%- comment -%} ──────────────────────────  L'ÉQUIPE ────────────────────────── {%- endcomment -%}
<section class="about-team">
  <div class="about-team-inner">
    <div class="section-head">
      <span class="eyebrow">L'équipe</span>
      <h2>Les visages <em>derrière la maison</em>.</h2>
      <p>Une petite équipe, choisie pour son exigence — et pour ce qu'elle a à dire.</p>
    </div>
    <div class="about-team-grid">
      <div class="about-portrait">
        <div class="about-portrait-img" aria-hidden="true"></div>
        <h3>Aurélia Marchand</h3>
        <span class="role">Fondatrice &amp; direction</span>
        <p class="bio">
          Ancienne consultante beauté Estée Lauder (8 ans). Diplômée de l'ISIPCA. Pilote la stratégie produit et la vision de la marque depuis Paris.
        </p>
      </div>
      <div class="about-portrait">
        <div class="about-portrait-img" aria-hidden="true"></div>
        <h3>Dr [PLACEHOLDER]</h3>
        <span class="role">Dermatologue consultante</span>
        <p class="bio">
          Dermatologue libérale, membre de la Société Française de Dermatologie. Garante de nos protocoles cliniques et de la sécurité d'usage.
        </p>
      </div>
      <div class="about-portrait">
        <div class="about-portrait-img" aria-hidden="true"></div>
        <h3>[PLACEHOLDER]</h3>
        <span class="role">Direction artistique</span>
        <p class="bio">
          Direction artistique formée aux Arts Déco. Pense chaque détail — du grain du papier à la lumière des photos — comme un prolongement du rituel.
        </p>
      </div>
    </div>
  </div>
</section>

{%- comment -%} ───────────────────────  CITATION DE CLÔTURE ──────────────────── {%- endcomment -%}
<section class="about-quote">
  <div class="about-quote-inner">
    <blockquote>
      Le luxe véritable, ce n'est pas l'inaccessible. C'est l'attention portée à dix minutes de votre journée, jour après jour.
    </blockquote>
    <cite>Aurélia Marchand · Fondatrice</cite>
  </div>
</section>

{%- comment -%} ─────────────────────────────  CTA  ───────────────────────────── {%- endcomment -%}
<section class="about-cta">
  <h2>Découvrez la <em>gamme AURÉLIA</em>.</h2>
  <p>Quatre masques, un rituel. Du visage au décolleté, en passant par le contour des yeux.</p>
  <a class="btn" href="{{ routes.collections_url }}">
    Découvrir la gamme
    <span class="arrow" aria-hidden="true">→</span>
  </a>
</section>
