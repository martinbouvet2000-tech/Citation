{%- comment -%}
  Usage:
    {% render 'wishlist-button', product: product %}
    {% render 'wishlist-button', product: product, variant: 'card' %}

  variant:
    - 'default' (page produit, label visible)
    - 'card' (overlay carte produit)
{%- endcomment -%}
{%- assign wl_variant = variant | default: 'default' -%}
{%- assign wl_product_id = product.id -%}
{%- assign wl_handle = product.handle -%}
{%- assign wl_title = product.title | escape -%}
{%- assign wl_price = product.price -%}
{%- assign wl_image = '' -%}
{%- if product.featured_image -%}
  {%- assign wl_image = product.featured_image | image_url: width: 400 -%}
{%- endif -%}

{%- if wl_variant == 'card' -%}
  <button type="button"
          class="wishlist-btn wishlist-btn-card"
          data-wishlist-toggle
          data-product-id="{{ wl_product_id }}"
          data-product-handle="{{ wl_handle }}"
          data-product-title="{{ wl_title }}"
          data-product-price="{{ wl_price }}"
          data-product-image="{{ wl_image }}"
          aria-label="Ajouter à mes favoris"
          aria-pressed="false">
    <svg class="wishlist-heart" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
  </button>
{%- else -%}
  <button type="button"
          class="wishlist-btn wishlist-btn-product"
          data-wishlist-toggle
          data-product-id="{{ wl_product_id }}"
          data-product-handle="{{ wl_handle }}"
          data-product-title="{{ wl_title }}"
          data-product-price="{{ wl_price }}"
          data-product-image="{{ wl_image }}"
          aria-pressed="false">
    <svg class="wishlist-heart" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
    <span class="wishlist-btn-label" data-wishlist-label>Ajouter à mes favoris</span>
  </button>
{%- endif -%}
