<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 80" role="img" aria-label="{{ settings.logo_text | default: shop.name | escape }}">
  <text x="160" y="48"
        font-family="'Cormorant Garamond', Georgia, serif"
        font-size="34"
        font-weight="400"
        letter-spacing="6"
        text-anchor="middle"
        fill="currentColor">{{ settings.logo_text | default: shop.name | escape }}</text>
  {%- if settings.logo_subtitle != blank -%}
    <text x="160" y="68"
          font-family="'Inter', system-ui, sans-serif"
          font-size="7"
          font-weight="400"
          letter-spacing="3"
          text-anchor="middle"
          fill="#C9A96E">{{ settings.logo_subtitle | upcase | escape }}</text>
  {%- endif -%}
</svg>
