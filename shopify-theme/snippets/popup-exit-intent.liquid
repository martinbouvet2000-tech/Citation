{%- comment -%}
  AURÉLIA — Exit-intent newsletter popup
  Triggers on mouseleave (top edge) after a delay, once per session.
  Skips cart, checkout & customer/account templates.
{%- endcomment -%}

{%- assign popup_skip_template = false -%}
{%- if template.name == 'cart' or template.directory == 'customers' -%}
  {%- assign popup_skip_template = true -%}
{%- endif -%}

{%- unless popup_skip_template -%}
<div class="exit-popup" id="ExitPopup" role="dialog" aria-modal="true" aria-labelledby="ExitPopupTitle" hidden>
  <div class="exit-popup-overlay" data-exit-close></div>
  <div class="exit-popup-card" role="document">
    <button type="button" class="exit-popup-close" aria-label="Fermer" data-exit-close>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="5" y1="5" x2="19" y2="19"/>
        <line x1="19" y1="5" x2="5" y2="19"/>
      </svg>
    </button>

    <div class="exit-popup-hero">
      <svg class="exit-popup-mask" viewBox="0 0 120 90" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M60 12c-22 0-44 8-44 28 0 22 16 36 44 36s44-14 44-36c0-20-22-28-44-28Z" stroke="currentColor" stroke-width="1.2" fill="none"/>
        <ellipse cx="42" cy="42" rx="9" ry="6" stroke="currentColor" stroke-width="1.1" fill="none"/>
        <ellipse cx="78" cy="42" rx="9" ry="6" stroke="currentColor" stroke-width="1.1" fill="none"/>
        <circle cx="42" cy="42" r="1.6" fill="currentColor"/>
        <circle cx="78" cy="42" r="1.6" fill="currentColor"/>
        <path d="M50 62c4 3 16 3 20 0" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" fill="none"/>
        <path d="M14 36l-6-3M106 36l6-3M14 56l-6 2M106 56l6 2" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/>
      </svg>
    </div>

    <div class="exit-popup-body">
      <p class="exit-popup-eyebrow">Newsletter AURÉLIA</p>
      <h2 id="ExitPopupTitle" class="exit-popup-title">Restez dans <em>la lumière</em>.</h2>
      <p class="exit-popup-sub">Recevez nos rituels de saison, conseils dermato et accès anticipé aux nouveautés. 1 email par mois, jamais plus.</p>

      <form action="{{ '/contact#newsletter' }}" method="post" accept-charset="UTF-8" class="exit-popup-form" id="ExitPopupForm">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="newsletter,exit-popup">
        <input type="email" name="contact[email]" placeholder="votre@email.com" autocomplete="email" required class="exit-popup-input" aria-label="Adresse email">
        <button type="submit" class="exit-popup-submit">M'inscrire</button>
      </form>

      <p class="exit-popup-bonus">Code <strong>WELCOME10</strong> offert sur votre première commande</p>
    </div>
  </div>
</div>

<style>
  .exit-popup {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.2rem;
  }
  .exit-popup[data-visible="true"] { display: flex; }
  .exit-popup-overlay {
    position: absolute;
    inset: 0;
    background: rgba(26, 20, 16, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .exit-popup[data-visible="true"] .exit-popup-overlay { opacity: 1; }
  .exit-popup-card {
    position: relative;
    width: 100%;
    max-width: 480px;
    background: var(--ivory);
    border: 1px solid var(--line);
    box-shadow: 0 30px 80px -20px rgba(26, 20, 16, 0.35);
    transform: scale(0.94);
    opacity: 0;
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    overflow: hidden;
  }
  .exit-popup[data-visible="true"] .exit-popup-card { transform: scale(1); opacity: 1; }
  .exit-popup-close {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    color: var(--ink-2);
    border-radius: 50%;
    transition: background 0.2s, color 0.2s;
    z-index: 2;
  }
  .exit-popup-close:hover { background: var(--cream); color: var(--bordeaux); }
  .exit-popup-hero {
    background: var(--cream);
    padding: 2rem 1.5rem 1rem;
    display: flex;
    justify-content: center;
    color: var(--gold);
  }
  .exit-popup-mask { width: 96px; height: auto; }
  .exit-popup-body { padding: 1.5rem 1.8rem 1.8rem; text-align: center; }
  .exit-popup-eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--bordeaux);
    font-weight: 500;
    margin-bottom: 0.6rem;
  }
  .exit-popup-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.9rem;
    font-weight: 400;
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: 0.7rem;
  }
  .exit-popup-title em { font-style: italic; color: var(--bordeaux); }
  .exit-popup-sub {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.55;
    margin-bottom: 1.3rem;
  }
  .exit-popup-form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }
  .exit-popup-input {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    background: var(--pearl);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    outline: none;
    transition: border-color 0.2s;
  }
  .exit-popup-input:focus { border-color: var(--gold); }
  .exit-popup-submit {
    width: 100%;
    padding: 0.95rem 1rem;
    background: var(--ink);
    color: var(--pearl);
    font-size: 0.76rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
    transition: background 0.25s;
  }
  .exit-popup-submit:hover { background: var(--bordeaux); }
  .exit-popup-bonus {
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.02em;
  }
  .exit-popup-bonus strong { color: var(--bordeaux); letter-spacing: 0.1em; font-weight: 500; }
  @media (max-width: 580px) {
    .exit-popup-title { font-size: 1.65rem; }
    .exit-popup-body { padding: 1.2rem 1.3rem 1.5rem; }
    .exit-popup-hero { padding: 1.6rem 1rem 0.6rem; }
  }
</style>

<script>
  (function () {
    var popup = document.getElementById('ExitPopup');
    if (!popup) return;

    var STORAGE_KEY = 'aurelia_exit_popup_shown';
    var ACTIVATION_DELAY = 15000; // 15s
    var path = window.location.pathname || '';
    var blocked = /^\/(cart|checkout|account)/i.test(path) || /^\/account/i.test(path);

    try {
      if (blocked) return;
      if (sessionStorage.getItem(STORAGE_KEY) === '1') return;
    } catch (e) { /* sessionStorage may throw in private mode */ }

    var armed = false;
    var shown = false;

    setTimeout(function () { armed = true; }, ACTIVATION_DELAY);

    function openPopup() {
      if (shown || !armed) return;
      shown = true;
      try { sessionStorage.setItem(STORAGE_KEY, '1'); } catch (e) {}
      popup.hidden = false;
      // double rAF to allow display flex to register before transition
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          popup.setAttribute('data-visible', 'true');
        });
      });
      document.body.style.overflow = 'hidden';
    }

    function closePopup() {
      popup.removeAttribute('data-visible');
      document.body.style.overflow = '';
      setTimeout(function () { popup.hidden = true; }, 350);
    }

    document.addEventListener('mouseleave', function (e) {
      if (e.clientY <= 0) openPopup();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && popup.getAttribute('data-visible') === 'true') closePopup();
    });

    popup.querySelectorAll('[data-exit-close]').forEach(function (el) {
      el.addEventListener('click', closePopup);
    });
  })();
</script>
{%- endunless -%}
