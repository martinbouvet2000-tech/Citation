<section class="product-page">
  {% render 'breadcrumbs' %}
  <div class="product-page-inner">
    <div class="product-media">
      <div class="product-media-main">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="eager">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="product-media-thumbs">
          {%- for image in product.images limit: 8 -%}
            <img src="{{ image | image_url: width: 240 }}"
                 data-full="{{ image | image_url: width: 1200 }}"
                 alt="{{ image.alt | default: product.title | escape }}"
                 class="{% if forloop.first %}active{% endif %}"
                 loading="lazy">
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-details">
      {%- if product.vendor != blank and settings.show_vendor -%}
        <div class="vendor">{{ product.vendor }}</div>
      {%- endif -%}
      <h1>{{ product.title }}</h1>

      <div class="price-row">
        <span class="price-current" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="price-old">{{ product.compare_at_price | money }}</span>
          <span class="price-save">−{{ product.compare_at_price | minus: product.price | money }}</span>
        {%- endif -%}
      </div>

      {%- if product.description != blank -%}
        <div class="product-description">{{ product.description }}</div>
      {%- endif -%}

      <form data-add-to-cart {% if product.has_only_default_variant == false %}data-variants='{{ product.variants | json | escape }}'{% endif %}>
        {%- unless product.has_only_default_variant -%}
          <div class="product-options">
            {%- for option in product.options_with_values -%}
              <div class="option-row">
                <label>{{ option.name }}</label>
                <select data-option-index="{{ forloop.index0 }}" data-variant-picker>
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="qty-row">
          <span style="font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink-3);font-weight:500;">{{ 'products.product.quantity' | t }}</span>
          <div class="qty-stepper">
            <button type="button" data-qty-change="-1" aria-label="{{ 'products.product.decrease_quantity' | t }}">−</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" data-qty-change="1" aria-label="{{ 'products.product.increase_quantity' | t }}">+</button>
          </div>
        </div>

        {%- liquid
          assign variant = product.selected_or_first_available_variant
          assign show_stock_badge = false
          assign stock_badge_class = ''
          assign stock_badge_text = ''
          if variant.inventory_management != blank and variant.inventory_policy != 'continue'
            if variant.inventory_quantity > 0 and variant.inventory_quantity <= 5
              assign show_stock_badge = true
              assign stock_badge_class = 'stock-badge-low'
              assign stock_badge_text = 'Plus que ' | append: variant.inventory_quantity | append: ' en stock — commandez vite'
            endif
          endif
          if variant.inventory_management != blank and variant.inventory_quantity <= 0 and product.available
            assign show_stock_badge = true
            assign stock_badge_class = 'stock-badge-out'
            assign stock_badge_text = 'Rupture temporaire — précommande sous 14 j'
          endif
        -%}
        {%- if show_stock_badge -%}
          <div class="stock-badge {{ stock_badge_class }}" role="status" aria-live="polite">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 9v4"/>
              <path d="M12 17h.01"/>
              <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
            </svg>
            <span>{{ stock_badge_text }}</span>
          </div>
        {%- endif -%}

        {%- if product.available -%}
          <button type="submit" class="product-cta" data-main-atc>
            {{ 'products.product.add_to_cart' | t }}
          </button>
        {%- else -%}
          {% render 'back-in-stock', product: product %}
        {%- endif -%}

        {% render 'wishlist-button', product: product %}
      </form>

      {% render 'google-shopping', product: product %}

      <div class="product-meta">
        <div class="product-meta-item">
          {% render 'icon', name: 'truck' %}
          <span>Livraison offerte dès 150€</span>
        </div>
        <div class="product-meta-item">
          {% render 'icon', name: 'shield' %}
          <span>Garantie 2 ans</span>
        </div>
        <div class="product-meta-item">
          {% render 'icon', name: 'check-circle' %}
          <span>Retour gratuit 30 jours</span>
        </div>
        <div class="product-meta-item">
          {% render 'icon', name: 'card' %}
          <span>Paiement 3× sans frais</span>
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%} Sticky add-to-cart mobile bar — visible on mobile only when main CTA is off-screen {%- endcomment -%}
<div class="sticky-atc" id="StickyATC" aria-hidden="true">
  <div class="sticky-atc-inner">
    <div class="sticky-atc-thumb">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 140 }}" alt="{{ product.title | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    <div class="sticky-atc-price">
      <span class="sticky-atc-title">{{ product.title | truncate: 28 }}</span>
      <span class="sticky-atc-amount" data-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</span>
    </div>
    <button type="button" class="sticky-atc-btn" data-sticky-atc {% unless product.available %}disabled{% endunless %}>
      {%- if product.available -%}Ajouter{%- else -%}Épuisé{%- endif -%}
    </button>
  </div>
</div>

<script>
  (function () {
    var stickyBar = document.getElementById('StickyATC');
    var mainBtn = document.querySelector('[data-main-atc]');
    if (!stickyBar || !mainBtn) return;

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            stickyBar.removeAttribute('data-visible');
            stickyBar.setAttribute('aria-hidden', 'true');
          } else {
            stickyBar.setAttribute('data-visible', 'true');
            stickyBar.setAttribute('aria-hidden', 'false');
          }
        });
      }, { threshold: 0, rootMargin: '0px 0px -10px 0px' });
      observer.observe(mainBtn);
    }

    var stickyBtn = stickyBar.querySelector('[data-sticky-atc]');
    if (stickyBtn) {
      stickyBtn.addEventListener('click', function () {
        var form = mainBtn.closest('form[data-add-to-cart]');
        if (form) {
          if (typeof form.requestSubmit === 'function') {
            form.requestSubmit(mainBtn);
          } else {
            mainBtn.click();
          }
        }
      });
    }

    // Sync price when variant changes
    var mainPrice = document.querySelector('[data-product-price]');
    var stickyPrice = stickyBar.querySelector('[data-sticky-price]');
    if (mainPrice && stickyPrice) {
      var mo = new MutationObserver(function () { stickyPrice.textContent = mainPrice.textContent; });
      mo.observe(mainPrice, { childList: true, characterData: true, subtree: true });
    }
  })();
</script>

{% schema %}
{
  "name": "Page produit",
  "settings": []
}
{% endschema %}
